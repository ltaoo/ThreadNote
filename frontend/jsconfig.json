{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "checkJs": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.js",
    "src/types/**/*.d.ts",
    "types/index.d.ts",
    "types/global.d.ts",
    "types/timeless.core.d.ts"
  ]
}
