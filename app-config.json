{
  "app": {
    "name": "ThreadNote",
    "display_name": "ThreadNote",
    "description": "A local-first workspace for Markdown notes, tasks, and project knowledge",
    "version": "1.0.0",
    "author": "ThreadNote Contributors",
    "icon": "assets/appicon.png"
  },
  "binary": {
    "project_name": "threadnote"
  },
  "platforms": {
    "macos": {
      "bundle_id": "com.threadnote.desktop",
      "icon_file": "assets/appicon.png",
      "min_system_version": "10.13",
      "category": "public.app-category.productivity",
      "entitlements": {
        "network_client": true
      },
      "dmg": {
        "background": {
          "custom_path": "assets/dmg-background.png"
        }
      }
    },
    "windows": {
      "company_name": "ThreadNote",
      "product_name": "ThreadNote",
      "file_description": "ThreadNote Desktop",
      "internal_name": "ThreadNote",
      "original_filename": "ThreadNote.exe",
      "icon_files": {
        "png": "assets/appicon.png",
        "png16": "assets/appicon.png"
      }
    },
    "linux": {
      "icon_file": "assets/appicon.png",
      "desktop_entry": {
        "categories": "Office;Utility;",
        "keywords": "threadnote;notes;memo;markdown;tasks;productivity;"
      }
    }
  },
  "build": {
    "config_files": [],
    "exclude_files": []
  },
  "release": {
    "footer": "ThreadNote · Built with Velo"
  },
  "update": {
    "enabled": true,
    "check_frequency": "startup",
    "channel": "stable",
    "auto_download": false,
    "timeout": 300,
    "sources": []
  }
}
