{
  "app": {
    "name": "ThreadNote",
    "display_name": "ThreadNote",
    "description": "A local-first workspace for Markdown notes, tasks, and project knowledge",
    "version": "1.0.0",
    "author": "ThreadNote Contributors",
    "icon": "assets/threadnote-logo.png"
  },
  "binary": {
    "project_name": "threadnote"
  },
  "platforms": {
    "macos": {
      "bundle_id": "com.funzm.threadnote",
      "icon_file": "assets/threadnote-logo.png",
      "min_system_version": "11.0",
      "category": "public.app-category.productivity",
      "entitlements": {
        "network_client": true
      },
      "dmg": {
        "background": {
          "custom_path": "assets/dmg-background.png"
        }
      }
    },
    "windows": {
      "company_name": "ThreadNote",
      "product_name": "ThreadNote",
      "file_description": "ThreadNote",
      "internal_name": "ThreadNote",
      "original_filename": "ThreadNote.exe",
      "icon_files": {
        "png": ".build/icons/icon_256.png",
        "png16": ".build/icons/icon_16.png"
      }
    },
    "linux": {
      "icon_file": "assets/threadnote-logo.png",
      "desktop_entry": {
        "categories": "Office;Utility;",
        "keywords": "threadnote;notes;memo;markdown;tasks;productivity;"
      }
    }
  },
  "build": {
    "config_files": [],
    "exclude_files": []
  },
  "release": {
    "footer": "ThreadNote · Built with Velo"
  },
  "update": {
    "enabled": true,
    "check_frequency": "startup",
    "channel": "stable",
    "auto_download": false,
    "timeout": 300,
    "sources": [
      {
        "type": "github",
        "priority": 0,
        "enabled": true,
        "need_check_checksum": false,
        "github_repo": "ltaoo/ThreadNote",
        "self_url": "http://127.0.0.1:8080"
      },
      {
        "type": "github",
        "priority": 100,
        "enabled": true,
        "need_check_checksum": true,
        "github_repo": "ltaoo/ThreadNote",
        "self_url": ""
      }
    ]
  }
}
